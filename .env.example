# ---------------------------------------------------------------
# METRICA HUMAN VALUE MAP — environment variables
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Conference mode (tablet at the booth). "true" shows the
# "Next visitor" flow. Can also be toggled per device with ?conference=1 / ?conference=0
NEXT_PUBLIC_CONFERENCE_MODE=false

# --- Phase 2: Supabase (not used yet) --------------------------
# Public project URL
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3: Admin dashboard (not used yet) -------------------
# ADMIN_PASSWORD=
