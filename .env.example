# ---------------------------------------------------------------
# METRICA HUMAN VALUE MAP — environment variables for LOCAL development
# Copy to .env.local.
# On the production server, runtime settings live in /etc/metrica-hvm/env
# (template: deploy/env.example), and NEXT_PUBLIC_* values are set at build time
# in GitHub Actions (repository variables).
# ---------------------------------------------------------------

# Public base URL (used for link previews and robots.txt). Build-time value.
NEXT_PUBLIC_SITE_URL=https://cx.metrica.bg

# Conference mode (tablet at the booth). "true" shows the
# "Next visitor" flow. Can also be toggled per device with ?conference=1 / ?conference=0
NEXT_PUBLIC_CONFERENCE_MODE=false

# --- MySQL (server-only; never exposed to the browser) ----------
# Without these: development logs submissions to the terminal; production refuses to save.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
MYSQL_DATABASE=metrica_hvm
MYSQL_USER=hvm_app
MYSQL_PASSWORD=
# MYSQL_SSL=false
# MYSQL_POOL_SIZE=5

# --- Admin dashboard (/admin) ------------------------------------
# Shared password for the Metrica team. Use a long random value (16+ characters).
# Changing it signs everyone out. Without it, /admin cannot be opened.
ADMIN_PASSWORD=
