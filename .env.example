# Build-time settings only (copy to .env.local for local builds; in CI they are
# GitHub repository variables). Database and admin passwords are NOT set here —
# they live in api/config.php on the server.

# Public base URL (link previews, robots.txt)
NEXT_PUBLIC_SITE_URL=https://cx.metrica.bg

# Conference mode for every device. Usually leave false and use ?conference=1 on the booth tablet.
NEXT_PUBLIC_CONFERENCE_MODE=false
