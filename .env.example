# ---------------------------------------------------------------
# METRICA HUMAN VALUE MAP — environment variables
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public base URL of this deployment (used for metadata / robots).
# Production: https://cx.metrica.bg  ·  Preview/staging: the *.vercel.app URL
NEXT_PUBLIC_SITE_URL=https://cx.metrica.bg

# Conference mode (tablet at the booth). "true" shows the
# "Next visitor" flow. Can also be toggled per device with ?conference=1 / ?conference=0
NEXT_PUBLIC_CONFERENCE_MODE=false

# --- Supabase ---------------------------------------------------
# Supabase dashboard → Project Settings → API.
# Both are used ONLY on the server (Next.js API routes). The browser never talks to Supabase.
# Without them: development logs submissions to the terminal; production returns 503.
SUPABASE_URL=https://xxxx.supabase.co
# SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard (/admin) ------------------------------------
# Shared password for the Metrica team. Use a long random value (16+ characters).
# Changing it signs everyone out. Without it, /admin cannot be opened.
ADMIN_PASSWORD=
