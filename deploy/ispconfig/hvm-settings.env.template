# hvm-settings.env — settings for the Metrica Human Value Map (read by start.js at startup).
# Format: KEY=value — paste values exactly as they are (any characters, no quotes needed).
# Lines starting with # are ignored. After a change, upload restart.txt to apply it.
# This file holds passwords: keep it OUT of the public /web folder.

# Internal port (localhost only). Must match proxy_pass in the Nginx directives.
PORT=3100

# MySQL — use the exact names shown in ISPConfig → Sites → Databases
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=metrica_hvm
MYSQL_USER=hvm_app
MYSQL_PASSWORD=
# Optional: connect via the MySQL socket instead of TCP (then MYSQL_HOST is ignored)
# MYSQL_SOCKET=/run/mysqld/mysqld.sock

# Admin dashboard (/admin): long random value, 16+ characters
ADMIN_PASSWORD=
