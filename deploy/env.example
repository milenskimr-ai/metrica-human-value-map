# /etc/metrica-hvm/env  — runtime settings for the app (read by systemd)
# Permissions: owner root, group metrica-hvm, mode 640
#   chown root:metrica-hvm /etc/metrica-hvm/env && chmod 640 /etc/metrica-hvm/env

# Internal port (must be free; Nginx proxies to 127.0.0.1:PORT)
PORT=3100

# MySQL — dedicated database and restricted user (see mysql/*.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Or connect over the Unix socket instead of TCP (then MYSQL_HOST is ignored):
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
MYSQL_DATABASE=metrica_hvm
MYSQL_USER=hvm_app
MYSQL_PASSWORD=
# "true" if the MySQL server requires TLS
MYSQL_SSL=false
# Max parallel DB connections for this app (keep small on a shared server)
MYSQL_POOL_SIZE=5

# Admin dashboard (/admin) — long random value, 16+ characters.
# Changing it signs everyone out (restart the service afterwards).
ADMIN_PASSWORD=
